# Enter actual values in Coolify's protected environment settings.
# This file contains placeholders and is excluded from Docker build context.
NODE_ENV=production
PORT=8080
DOMAIN=https://futuremusic.online
SESSION_SECRET=

# Use the restored application's own MySQL database/user on a private Docker network.
# This repository uses MySQL; pg is installed but not used by the server.
DB_HOST=REPLACE_WITH_PRIVATE_MYSQL_SERVICE_HOSTNAME
DB_PORT=3306
DB_NAME=REPLACE_WITH_EXISTING_DATABASE_NAME
DB_USER=REPLACE_WITH_APPLICATION_DATABASE_USER
DB_PASSWORD=
DB_CONNECTION_LIMIT=5
# Remove INSTANCE_CONNECTION_NAME for OVH; do not point staging at live Cloud SQL.

# Preserve Google Storage until the private destination copy and access are verified.
OBJECT_STORAGE_PROVIDER=gcs
GOOGLE_CLOUD_PROJECT=futuremusic
GCS_BUCKET_NAME=futuremusic
HERO_SLAYER_GCS_PATH=downloads/hero-slayer-alpha.zip
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-storage.json
# Mount the credentials file read-only; never copy it into the image or repository.

# Opt-in only after copying/validating the objects into a PRIVATE OVH S3 bucket:
# OBJECT_STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://s3.REPLACE_WITH_REGION.io.cloud.ovh.net
# S3_REGION=
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Existing logical GCS_BUCKET_NAME maps only to S3_BUCKET_NAME; paths stay identical.
# Evidence URLs keep their existing Google default until their access is reviewed.
# EVIDENCE_BASE_URL=

# Copy existing feature settings from Cloud Run/Secret Manager into Coolify as needed:
# STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET
# PRINTIFY_API_TOKEN, PRINTIFY_SHOP_ID
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS (or GMAIL_USER, GMAIL_APP_PASSWORD)
# CONTACT_TO, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
# LINKEDIN_CLIENT_ID, LINKEDIN_CLIENT_SECRET, PINATA_API_KEY, PINATA_SECRET_KEY
# XAI_API_KEY, XAI_MODEL, GAME_URL, HOME_IPS
