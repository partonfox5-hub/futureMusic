<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Rampart Reborn' %> | Future Music</title>
  <style>
    :root {
      --gold: #D4AF37;
      --gold-dim: #a88620;
      --bg: #0c0e12;
      --panel: #141820;
      --border: #2a3140;
      --text: #e8e6e0;
      --muted: #9aa3b2;
      --danger: #c44;
      --ok: #3a9;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0; height: 100%;
      background: var(--bg); color: var(--text);
      font-family: "Segoe UI", system-ui, sans-serif;
      overflow: hidden;
    }
    .shell {
      display: grid;
      grid-template-columns: 300px 1fr;
      grid-template-rows: 52px minmax(0, 1fr);
      height: 100vh;
      height: 100dvh;
      max-height: 100dvh;
      overflow: hidden;
    }
    .topbar {
      grid-column: 1 / -1;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 16px;
      background: #000;
      border-bottom: 1px solid var(--border);
      z-index: 20;
    }
    .topbar a {
      color: var(--gold); text-decoration: none; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.06em; font-size: 13px;
    }
    .topbar a:hover { color: #fff; }
    .topbar h1 {
      margin: 0; font-size: 14px; letter-spacing: 0.18em;
      font-weight: 600; color: #fff; text-transform: uppercase;
    }
    .badge {
      font-size: 11px; color: var(--muted);
      border: 1px solid var(--border); padding: 4px 10px; border-radius: 999px;
    }
    .rail {
      background: var(--panel);
      border-right: 1px solid var(--border);
      overflow-y: auto;
      padding: 14px 12px 24px;
      display: flex; flex-direction: column; gap: 12px;
    }
    .rail h2 {
      margin: 8px 0 4px; font-size: 11px; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--gold);
    }
    .rail p.hint { margin: 0; font-size: 12px; color: var(--muted); line-height: 1.4; }
    .btn {
      display: block; width: 100%; text-align: center;
      background: transparent; color: var(--gold);
      border: 1px solid var(--gold);
      padding: 10px 12px; border-radius: 6px;
      font-weight: 700; font-size: 12px; letter-spacing: 0.06em;
      text-transform: uppercase; cursor: pointer;
      text-decoration: none;
      transition: background 0.15s, color 0.15s;
    }
    .btn:hover { background: var(--gold); color: #000; }
    .btn.primary { background: var(--gold); color: #000; }
    .btn.primary:hover { background: #fff; }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn.ghost { border-color: var(--border); color: var(--muted); }
    .stage {
      position: relative; background: #000; min-width: 0; min-height: 0;
      overflow: hidden;
    }
    .stage iframe {
      position: absolute; inset: 0; width: 100%; height: 100%;
      border: 0; background: #000;
    }
    .fork-list { display: flex; flex-direction: column; gap: 8px; }
    .fork-card {
      border: 1px solid var(--border); border-radius: 8px;
      padding: 10px; background: #0f1218;
    }
    .fork-card.active { border-color: var(--gold); }
    .fork-card h3 { margin: 0 0 4px; font-size: 13px; color: #fff; }
    .fork-card .meta { font-size: 11px; color: var(--muted); margin-bottom: 8px; }
    .fork-card .btn { padding: 7px; font-size: 11px; }
    .status-line {
      font-size: 11px; color: var(--muted); min-height: 1.2em;
    }
    .status-line.ok { color: var(--ok); }
    .status-line.err { color: var(--danger); }
    #upload-file { display: none; }
    .modal-backdrop {
      display: none; position: fixed; inset: 0; z-index: 100;
      background: rgba(0,0,0,0.72); align-items: center; justify-content: center;
      padding: 20px;
    }
    .modal-backdrop.open { display: flex; }
    .modal {
      background: var(--panel); border: 1px solid var(--gold);
      border-radius: 10px; max-width: 560px; width: 100%;
      max-height: 85vh; overflow-y: auto; padding: 22px 24px;
    }
    .modal h2 { margin: 0 0 12px; color: var(--gold); font-size: 20px; }
    .modal ol { padding-left: 20px; color: var(--text); line-height: 1.55; font-size: 14px; }
    .modal pre {
      background: #0a0c10; border: 1px solid var(--border);
      padding: 12px; border-radius: 6px; font-size: 12px;
      white-space: pre-wrap; color: #cde; overflow-x: auto;
    }
    .modal .close-row { text-align: right; margin-top: 16px; }
    @media (max-width: 800px) {
      .shell { grid-template-columns: 1fr; grid-template-rows: 52px auto 1fr; }
      .rail { max-height: 40vh; border-right: 0; border-bottom: 1px solid var(--border); }
      .stage { min-height: 50vh; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <a href="/projects">&larr; Projects</a>
      <h1>Rampart Reborn</h1>
      <span class="badge" id="version-badge">Official v1</span>
    </header>

    <aside class="rail" aria-label="Mod lab">
      <h2>Play</h2>
      <button type="button" class="btn primary" id="btn-play-official">Play official</button>
      <p class="hint">Multiplayer: create a room inside the game, share the code, wait for a friend, both press Ready.</p>

      <h2>Mod lab (pilot)</h2>
      <a class="btn" id="btn-download" href="/api/rampart/download">Download source</a>
      <button type="button" class="btn" id="btn-guide">Grok Build starter guide</button>
      <% if (typeof forkUploadsEnabled !== 'undefined' && forkUploadsEnabled) { %>
      <button type="button" class="btn" id="btn-upload">Upload fork (login)</button>
      <input type="file" id="upload-file" accept=".zip,application/zip" />
      <p class="status-line" id="upload-status"></p>
      <p class="hint">Uploads are scanned for safety. Same protocol version can multiplayer together.</p>
      <% } else { %>
      <button type="button" class="btn" id="btn-upload" disabled title="Temporarily locked">Upload fork — locked</button>
      <input type="file" id="upload-file" accept=".zip,application/zip" disabled />
      <p class="status-line err" id="upload-status">Fork uploads are temporarily locked.</p>
      <p class="hint">Official multiplayer still works. Community uploads will reopen later.</p>
      <% } %>

      <h2>Community forks</h2>
      <div class="fork-list" id="fork-list">
        <p class="hint">Loading forks…</p>
      </div>
    </aside>

    <main class="stage">
      <iframe
        id="game-frame"
        title="Rampart Reborn"
        src="/games/rampart-reborn/official/v1/index.html"
        sandbox="allow-scripts allow-same-origin allow-pointer-lock allow-popups allow-forms"
        allow="autoplay; fullscreen; gamepad"
        referrerpolicy="no-referrer"
        allowfullscreen
      ></iframe>
    </main>
  </div>

  <div class="modal-backdrop" id="guide-modal" role="dialog" aria-modal="true" aria-labelledby="guide-title">
    <div class="modal">
      <h2 id="guide-title">Grok Build — starter guide</h2>
      <ol>
        <li>Create an xAI / Grok account if you do not have one.</li>
        <li>Install or open <strong>Grok Build</strong> (desktop CLI / TUI).</li>
        <li>Download the Rampart source zip from this page and unzip it.</li>
        <li>Open that folder as your workspace in Grok Build.</li>
        <li>Use a first prompt like the one below — keep multiplayer intact.</li>
        <li>Re-zip the game root (must include <code>index.html</code> + <code>module.manifest.json</code>) and upload here.</li>
      </ol>
      <p class="hint" style="margin:12px 0 6px;color:var(--muted);font-size:13px;">Example first prompt:</p>
      <pre>Open this Rampart Reborn folder. Keep multiplayer (PeerJS, room codes,
Ready flow, module.manifest.json protocolVersion) intact. Tweak wall HP
and cannon ammo for a faster siege, then tell me what you changed.</pre>
      <div class="close-row">
        <button type="button" class="btn primary" id="btn-guide-close">Close</button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const frame = document.getElementById('game-frame');
      const badge = document.getElementById('version-badge');
      const forkList = document.getElementById('fork-list');
      const statusEl = document.getElementById('upload-status');
      const fileInput = document.getElementById('upload-file');
      const loggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
      const forkUploadsEnabled = <%= typeof forkUploadsEnabled !== 'undefined' && forkUploadsEnabled ? 'true' : 'false' %>;

      function setGame(src, label) {
        frame.src = src;
        badge.textContent = label || 'Playing';
      }

      document.getElementById('btn-play-official').addEventListener('click', () => {
        setGame('/games/rampart-reborn/official/v1/index.html', 'Official v1');
      });

      document.getElementById('btn-guide').addEventListener('click', () => {
        document.getElementById('guide-modal').classList.add('open');
      });
      document.getElementById('btn-guide-close').addEventListener('click', () => {
        document.getElementById('guide-modal').classList.remove('open');
      });
      document.getElementById('guide-modal').addEventListener('click', (e) => {
        if (e.target.id === 'guide-modal') e.target.classList.remove('open');
      });

      document.getElementById('btn-upload')?.addEventListener('click', () => {
        if (!forkUploadsEnabled) {
          statusEl.textContent = 'Fork uploads are temporarily locked.';
          statusEl.className = 'status-line err';
          return;
        }
        if (!loggedIn) {
          statusEl.textContent = 'Log in on the site, then return here to upload.';
          statusEl.className = 'status-line err';
          window.location.href = '/login?next=/rampart';
          return;
        }
        fileInput.click();
      });

      fileInput?.addEventListener('change', async () => {
        if (!forkUploadsEnabled) {
          statusEl.textContent = 'Fork uploads are temporarily locked.';
          statusEl.className = 'status-line err';
          return;
        }
        const file = fileInput.files && fileInput.files[0];
        if (!file) return;
        statusEl.textContent = 'Uploading & validating…';
        statusEl.className = 'status-line';
        const fd = new FormData();
        fd.append('zip', file);
        try {
          const res = await fetch('/api/rampart/upload', { method: 'POST', body: fd, credentials: 'same-origin' });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            if (res.status === 401) {
              statusEl.textContent = 'Login required — redirecting…';
              statusEl.className = 'status-line err';
              window.location.href = '/login';
              return;
            }
            statusEl.textContent = data.error || data.message || ('Upload failed (' + res.status + ')');
            statusEl.className = 'status-line err';
            if (data.report) console.warn('Validation report', data.report);
            return;
          }
          statusEl.textContent = 'Published: ' + (data.title || data.forkId);
          statusEl.className = 'status-line ok';
          loadForks();
          if (data.playPath) setGame(data.playPath, data.title || 'Fork');
        } catch (err) {
          statusEl.textContent = 'Network error: ' + err.message;
          statusEl.className = 'status-line err';
        } finally {
          fileInput.value = '';
        }
      });

      async function loadForks() {
        try {
          const res = await fetch('/api/rampart/forks');
          const data = await res.json();
          const forks = data.forks || [];
          if (!forks.length) {
            forkList.innerHTML = '<p class="hint">No community forks yet — be the first.</p>';
            return;
          }
          forkList.innerHTML = '';
          forks.slice().reverse().forEach((f) => {
            const card = document.createElement('div');
            card.className = 'fork-card';
            card.innerHTML =
              '<h3></h3><div class="meta"></div><button type="button" class="btn">Play this fork</button>';
            card.querySelector('h3').textContent = f.title || f.forkId;
            card.querySelector('.meta').textContent =
              (f.author || 'anon') +
              ' · v' + (f.version || '?') +
              ' · protocol ' + (f.protocolVersion != null ? f.protocolVersion : '?') +
              (f.verified ? ' · ' + f.verified : '');
            card.querySelector('button').addEventListener('click', () => {
              document.querySelectorAll('.fork-card').forEach((c) => c.classList.remove('active'));
              card.classList.add('active');
              setGame(f.playPath, f.title || f.forkId);
            });
            forkList.appendChild(card);
          });
        } catch (e) {
          forkList.innerHTML = '<p class="hint">Could not load forks.</p>';
        }
      }

      // Deep-link: /rampart?room=CODE → pass into iframe query for future auto-join
      const params = new URLSearchParams(location.search);
      const room = params.get('room');
      if (room) {
        frame.src = '/games/rampart-reborn/official/v1/index.html?room=' + encodeURIComponent(room);
      }

      loadForks();
    })();
  </script>
</body>
</html>
