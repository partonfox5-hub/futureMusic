<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/images/logo.png">
    <title>Battle Sphere Arena — Meta Quest</title>
    <meta name="description" content="Battle Sphere Arena is a zero-g VR melee game for Meta Quest, published by Future Music Collective on the Meta Horizon Store.">
    <link rel="canonical" href="https://futuremusic.online/battle-sphere-arena/quest">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://futuremusic.online/battle-sphere-arena/quest">
    <meta property="og:title" content="Battle Sphere Arena — Meta Quest">
    <meta property="og:description" content="Zero-g VR melee in a livestreamed coliseum of linked spheres. Available on the Meta Horizon Store.">
    <meta property="og:image" content="https://futuremusic.online/images/battle-sphere-arena/cover.jpg">
    <meta name="twitter:card" content="summary_large_image">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Raleway:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --gold: #D4AF37; --gold-light: #F4C430; --void: #050505; --teal: #20B2AA; }
        body { font-family: 'Raleway', sans-serif; background: var(--void); color: #fff; margin: 0; min-height: 100vh; }
        h1, h2, .brand-font { font-family: 'Cinzel', serif; }
        .text-gold {
            background: linear-gradient(to bottom, var(--gold-light), var(--gold), #AA8C2C);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        a { color: var(--gold); }
        a:hover { color: #fff; }
    </style>
</head>
<body>
    <header class="border-b border-yellow-700/40 bg-black/90">
        <div class="max-w-4xl mx-auto px-6 py-5 flex items-center gap-3">
            <img src="/images/logo.png" alt="Future Music Collective" class="h-10 w-auto">
            <span class="text-sm tracking-widest uppercase text-gold brand-font">Future Music Collective</span>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12">
        <p class="text-xs tracking-[0.28em] uppercase text-[#20B2AA] font-bold mb-3">Meta Horizon Store</p>
        <h1 class="text-4xl md:text-6xl font-bold text-gold brand-font uppercase tracking-wide m-0">Battle Sphere Arena</h1>
        <p class="text-gray-300 text-lg leading-relaxed mt-5 max-w-2xl">
            Zero-g melee inside a livestreamed coliseum of linked spheres. Fly, cut, lasso, and hunt before your power hits zero.
            <strong class="text-white">Battle Sphere Arena</strong> on Meta Quest is published by Future Music Collective.
        </p>

        <img src="/images/battle-sphere-arena/cover.jpg" alt="Battle Sphere Arena" class="w-full rounded-lg border border-yellow-700/40 mt-8 mb-10">

        <section class="space-y-4 text-gray-300 leading-relaxed">
            <h2 class="text-xl text-[#D4AF37] font-bold uppercase tracking-wider">On Meta Quest</h2>
            <p>
                Get <strong class="text-white">Battle Sphere Arena</strong> from the Meta Horizon Store on your headset.
                Purchased digital content and functionality for this Quest app are available only through Meta platform commerce.
                This page does not sell the Quest app, in-app items, or any other digital content for <strong class="text-white">Battle Sphere Arena</strong>.
            </p>
        </section>

        <section class="space-y-4 text-gray-300 leading-relaxed mt-10">
            <h2 class="text-xl text-[#D4AF37] font-bold uppercase tracking-wider">Support</h2>
            <p>
                Privacy policy for <strong class="text-white">Battle Sphere Arena</strong>:
                <a href="/privacy">https://futuremusic.online/privacy</a>
            </p>
            <p>
                Terms of service:
                <a href="/terms">https://futuremusic.online/terms</a>
            </p>
            <p>
                Questions, support, or a data-deletion request:
                <a href="/contact">https://futuremusic.online/contact</a>
            </p>
        </section>
    </main>

    <footer class="border-t border-yellow-700/30 mt-16 py-8 text-center text-xs tracking-wider uppercase text-gray-500">
        &copy; 2026 Future Music Collective · Battle Sphere Arena
    </footer>
</body>
</html>
