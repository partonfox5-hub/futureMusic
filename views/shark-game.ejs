<%- include('partials/header') %>
<style>
.shark-hero{position:relative;max-width:1200px;margin:1.5rem auto 0;overflow:hidden;border:1px solid #24555c;border-radius:16px;background:#04151c}
.shark-hero img{width:100%;display:block;aspect-ratio:16/9;object-fit:cover}
.shark-copy{max-width:1100px;margin:auto;padding:2.5rem 0;display:grid;grid-template-columns:1.15fr 1fr;gap:3rem}
.shark-copy h1{font-size:clamp(2.5rem,6vw,4rem);line-height:1.1;margin:.5rem 0 1.5rem;color:#f4c430}
.shark-copy p,.shark-copy li{line-height:1.7;color:#d1dce0}.shark-copy ul{margin:1.25rem 0;padding-left:1.25rem;list-style:disc}
.shark-buy{padding:1.8rem;border:1px solid #35636d;background:#071b23;border-radius:12px;align-self:start}.shark-buy label{display:flex;gap:.7rem;align-items:flex-start;font-size:.9rem;line-height:1.6;margin:1rem 0}.shark-buy input{margin-top:.35rem;min-width:18px;min-height:18px}
.shark-buy button{width:100%;padding:1rem;background:#f4c430;color:#04151c;font-weight:800;border-radius:6px}.shark-buy button:hover{background:white}.shark-buy button:focus-visible{outline:3px solid #55dcd0;outline-offset:4px}
.shark-gallery{max-width:1100px;margin:0 auto 3rem;display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.shark-gallery img{width:100%;border-radius:8px;border:1px solid #294650}.shark-gallery figcaption{font-size:.8rem;color:#abbfc6;padding-top:.5rem}
@media(max-width:700px){.shark-copy{grid-template-columns:1fr;gap:1.5rem;padding:2rem 0}.shark-buy{padding:1.25rem}.shark-gallery{grid-template-columns:1fr}}
</style>
<div class="shark-hero"><img src="/images/shark-game/landscape.webp" width="2560" height="1440" alt="Shark Game: a colossal shark approaching a submarine in a dark ocean"></div>
<section class="shark-copy" aria-labelledby="shark-title">
  <div>
    <p class="uppercase tracking-widest text-sm">Future Music Online · Single-player Quest VR</p>
    <h1 id="shark-title" class="brand-font">Shark Game</h1>
    <p>Your submarine is your only shelter. Explore towering coral formations and schools of sea life, track a colossal shark, and fire torpedoes before it reaches your windshield.</p>
    <ul>
      <li>A relentless shark that grows faster as the fight escalates.</li>
      <li>Three stages of submarine damage, from cracked glass to a total blackout.</li>
      <li>Exit into the dark with your flashlight and weld your submarine back together.</li>
      <li>A replayable introduction covering piloting, combat, swimming and repairs.</li>
    </ul>
    <p class="text-sm">Contains frightening shark encounters, animal violence and blood. Intended for ages 13+; regional age ratings may be higher. Meta Store review is pending.</p>
  </div>
  <aside class="shark-buy" aria-labelledby="shark-buy-title">
    <h2 id="shark-buy-title" class="text-2xl font-bold mb-2">Quest APK download</h2>
    <p class="text-3xl font-bold mb-3" style="color:#f4c430">US$9.99 <span class="text-sm font-normal text-gray-300">one-time purchase</span></p>
    <p class="mb-3">Requires Meta Quest 2, Quest Pro or Quest 3 / 3S, Touch controllers and a computer for APK sideloading. This download is not a browser game.</p>
    <p class="text-sm">A website purchase provides the APK file. It does not add the game to your Meta Horizon Store library. You must be able to enable developer mode and install an APK on your headset.</p>
    <% if (canceled) { %><p role="status" class="mt-4">Checkout canceled. You have not purchased the game.</p><% } %>
    <% if (available) { %>
    <form action="/api/shark-game/checkout" method="post">
      <label><input type="checkbox" name="install_ack" value="yes" required><span>I have a compatible Quest headset and can sideload an APK. I understand this is a direct download, separate from a Meta Store purchase.</span></label>
      <button type="submit">Buy &amp; download — $9.99</button>
    </form>
    <p class="text-sm mt-3">Secure checkout with Stripe. After payment, your private confirmation page provides the download. Bookmark it for future access.</p>
    <% } else { %>
    <p role="status" class="mt-5 p-4 rounded border border-teal-700">The download is being prepared. Checkout will open when the APK is ready.</p>
    <% } %>
    <p class="text-sm mt-4"><a href="/contact" class="underline">Purchase or installation support</a> · <a href="/terms#shark-game" class="underline">Purchase terms</a> · <a href="/privacy#shark-game" class="underline">Privacy</a></p>
  </aside>
</section>
<section class="shark-gallery" aria-label="In-game screenshots">
  <figure><img src="/images/shark-game/lunge.webp" width="888" height="500" loading="lazy" alt="The shark lunging with open jaws toward the submarine"><figcaption>Hold your nerve as the shark closes in.</figcaption></figure>
  <figure><img src="/images/shark-game/coral.webp" width="888" height="500" loading="lazy" alt="Tall coral and rock formations on the ocean floor"><figcaption>Navigate a dark ocean full of landmarks.</figcaption></figure>
  <figure><img src="/images/shark-game/damage.webp" width="888" height="500" loading="lazy" alt="Cracked submarine windshield and warning lights after an attack"><figcaption>Survive the damage and repair your shelter.</figcaption></figure>
</section>
<%- include('partials/footer') %>
