<% if (typeof landing !== 'undefined' && landing && landing.faq && landing.faq.length) { %>
<section class="seo-copy glass-card rounded-2xl p-8 md:p-10 mb-10" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-2xl md:text-3xl font-bold text-[#D4AF37] brand-font uppercase tracking-widest mb-6">
        <%= landing.gameName || 'Game' %> FAQ
    </h2>
    <dl>
        <% landing.faq.forEach(function (item) { %>
        <dt class="font-serif text-[#D4AF37] text-lg mb-2"><%= item.q %></dt>
        <dd class="text-gray-300 leading-relaxed mb-6"><%= item.a %></dd>
        <% }) %>
    </dl>
</section>
<% } %>
