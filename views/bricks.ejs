<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Blockbuild — $5 workshop</title>
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root { --sky:#b8d4f0; --ink:#1c1e24; --mute:#4a5564; --gold:#e6b35c; --brick:#c91a09; }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: var(--sky); color: var(--ink); font-family: Outfit, system-ui, sans-serif; }
    body {
      min-height: 100vh;
      background:
        radial-gradient(ellipse at 70% 12%, rgba(245,205,47,.2), transparent 48%),
        radial-gradient(ellipse at 12% 88%, rgba(201,26,9,.12), transparent 46%),
        var(--sky);
    }
    .wrap {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
      gap: 22px;
      max-width: 1120px;
      margin: 0 auto;
      padding: 28px 18px 40px;
      align-items: start;
    }
    @media (max-width: 820px) { .wrap { grid-template-columns: 1fr; } }
    .stage {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(28,30,36,.1);
      background: #9ec4ea;
      box-shadow: 0 18px 40px rgba(28,30,36,.12);
      aspect-ratio: 16 / 10;
    }
    .stage iframe, .stage video {
      position: absolute; inset: 0; width: 100%; height: 100%;
      border: 0; pointer-events: none; background: #9ec4ea;
    }
    .badge {
      position: absolute; top: 12px; left: 12px; z-index: 2;
      font-size: 11px; letter-spacing: .16em; text-transform: uppercase;
      background: rgba(28,30,36,.78); color: #fff; padding: 6px 10px; border-radius: 999px;
      font-weight: 600;
    }
    .card {
      background: rgba(255,255,255,.78);
      border: 1px solid rgba(28,30,36,.08);
      border-radius: 16px;
      padding: 26px 24px 22px;
    }
    .kicker { margin: 0; letter-spacing: .22em; text-transform: uppercase; font-size: 11px; color: var(--gold); font-weight: 700; }
    h1 { font-family: Fredoka, sans-serif; font-size: clamp(2.2rem, 6vw, 3.2rem); margin: 8px 0 10px; line-height: .95; }
    p { margin: 0 0 12px; color: var(--mute); line-height: 1.5; }
    .price { font-family: Fredoka, sans-serif; font-size: 2rem; color: var(--brick); margin: 8px 0 14px; }
    button {
      appearance: none; border: 0; cursor: pointer;
      background: var(--brick); color: #fff;
      font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
      padding: 14px 18px; border-radius: 10px; width: 100%; font-size: 14px;
    }
    button:hover { filter: brightness(1.08); }
    button:disabled { opacity: .55; cursor: wait; }
    .err { color: #c91a09; font-size: 13px; min-height: 1.2em; }
    .fine { font-size: 12px; color: #6a7380; margin-top: 12px; }
    a { color: var(--ink); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="stage">
      <span class="badge">AI demo · labeled controls</span>
      <video id="demo-vid" autoplay muted loop playsinline poster="/games/blockbuild/demo-poster.jpg">
        <source src="/games/blockbuild/demo.webm" type="video/webm" />
        <source src="/games/blockbuild/demo.mp4" type="video/mp4" />
      </video>
      <iframe id="live" title="Blockbuild demo" src="/games/blockbuild/index.html?demo=loop" allow="autoplay"></iframe>
    </div>
    <div class="card">
      <p class="kicker">Future Music Collective</p>
      <h1>Blockbuild</h1>
      <p>Fly an empty sky. Snap studded bricks. Interlock, melt, cannon, minifigs — desktop and VR.</p>
      <div class="price">It's only $5</div>
      <p>One-time unlock on this website. No subscription.</p>
      <button type="button" id="buy">Unlock Blockbuild — $5</button>
      <p class="err" id="err"></p>
      <p class="fine">Home network skips the paygate automatically. <a href="/projects">Projects</a></p>
    </div>
  </div>
  <script>
    (function () {
      var vid = document.getElementById("demo-vid");
      var live = document.getElementById("live");
      function hideLive() { if (live) live.style.display = "none"; }
      function hideVid() { if (vid) vid.style.display = "none"; }
      if (vid) {
        vid.addEventListener("loadeddata", function () {
          if (vid.videoWidth > 0) hideLive();
        });
        vid.addEventListener("error", hideVid);
        setTimeout(function () {
          if (!vid.videoWidth) hideVid();
        }, 1200);
      }
      document.getElementById("buy").onclick = async function () {
        var err = document.getElementById("err");
        var btn = this;
        err.textContent = "";
        btn.disabled = true;
        try {
          var res = await fetch("/api/blockbuild/checkout", { method: "POST", headers: { "content-type": "application/json" }, body: "{}" });
          var data = await res.json();
          if (data.url) { location.href = data.url; return; }
          err.textContent = data.error || "Checkout could not start.";
        } catch (e) {
          err.textContent = "Checkout is available on futuremusic.online.";
        }
        btn.disabled = false;
      };
    })();
  </script>
</body>
</html>
