<%- include('partials/header') %>

<style>
    .seo-copy.glass-card:hover,
    .game-embed.glass-card:hover {
        transform: none;
        border-color: rgba(212, 175, 55, 0.45);
    }
</style>

<article class="max-w-5xl mx-auto py-6 md:py-10" itemscope itemtype="https://schema.org/VideoGame">
    <p class="mb-6">
        <a href="/projects" class="text-[#D4AF37] hover:text-white text-sm uppercase tracking-widest font-bold">← Projects</a>
    </p>

    <header class="text-center mb-8">
        <p class="text-[#20B2AA] tracking-[0.35em] uppercase text-xs font-bold mb-3"><%= landing.eyebrow %></p>
        <h1 class="text-4xl md:text-6xl font-black text-gold brand-font uppercase tracking-tight mb-4" itemprop="name">
            <%= landing.h1 %>
        </h1>
        <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto leading-relaxed" itemprop="description">
            <%= landing.lede %>
        </p>
    </header>

    <% if (landing.tags && landing.tags.length) { %>
    <div class="flex flex-wrap justify-center gap-2 mb-8">
        <% landing.tags.forEach(function (tag) { %>
        <span class="px-3 py-1 border border-[#D4AF37]/40 text-[#D4AF37] text-xs uppercase tracking-widest rounded-full"><%= tag %></span>
        <% }) %>
    </div>
    <% } %>

    <% if (landing.playSrc) { %>
    <section class="game-embed glass-card rounded-2xl overflow-hidden border-t-4 border-[#D4AF37] mb-8">
        <div class="bg-black/50 px-4 py-3 border-b border-yellow-700/30 flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm text-gray-400 uppercase tracking-widest">Play in browser</p>
            <% if (landing.fullscreenHref) { %>
            <a href="<%= landing.fullscreenHref %>" class="btn-outline px-4 py-2 text-xs rounded-sm inline-block">Play fullscreen</a>
            <% } %>
        </div>
        <div class="relative w-full h-[70vh] min-h-[420px] bg-black">
            <iframe
                src="<%= landing.playSrc %>"
                class="absolute inset-0 w-full h-full"
                title="<%= landing.gameName %>"
                allow="<%= landing.iframeAllow %>"
                allowfullscreen
                loading="eager"></iframe>
        </div>
    </section>
    <% } else if (landing.playHref) { %>
    <div class="text-center mb-10">
        <a href="<%= landing.playHref %>" class="btn-gold px-10 py-4 text-lg rounded-sm inline-block" target="_blank" rel="noopener">
            <%= landing.playLabel %>
        </a>
        <p class="text-gray-500 text-sm mt-3">Opens the hosted game in a new tab.</p>
    </div>
    <% } %>

    <% if (landing.about && landing.about.length) { %>
    <section class="seo-copy glass-card rounded-2xl p-8 md:p-10 mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#D4AF37] brand-font uppercase tracking-widest mb-4">About <%= landing.gameName %></h2>
        <% landing.about.forEach(function (p) { %>
        <p class="text-gray-300 leading-relaxed mb-4"><%= p %></p>
        <% }) %>
    </section>
    <% } %>

    <% if (landing.howto && landing.howto.length) { %>
    <section class="seo-copy glass-card rounded-2xl p-8 md:p-10 mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#D4AF37] brand-font uppercase tracking-widest mb-4">How to play</h2>
        <ol class="list-decimal list-inside space-y-3 text-gray-300 leading-relaxed">
            <% landing.howto.forEach(function (step) { %>
            <li><%= step %></li>
            <% }) %>
        </ol>
    </section>
    <% } %>

    <%- include('partials/seo-faq') %>
    <%- include('partials/seo-related') %>
</article>

<%- include('partials/footer') %>
