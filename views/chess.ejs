<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <%- include('partials/seo-meta') %>
  <style>
    html, body { margin: 0; height: 100%; background: #0c0c0e; color: #f2f1ee; font-family: system-ui, sans-serif; overflow: hidden; }
    .bar {
      position: absolute; left: 0; right: 0; top: 0; z-index: 3;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      height: 40px; padding: 0 12px;
      background: rgba(12,12,14,0.94); border-bottom: 1px solid #2a2a30;
      font-size: 12px;
    }
    .bar a { color: #c5ccd4; text-decoration: none; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
    .bar span { color: #9a9892; }
    iframe { position: absolute; inset: 40px 0 0 0; width: 100%; height: calc(100% - 40px); border: 0; background: #0c0c0e; }
    @media (pointer: coarse) {
      .bar { height: 48px; }
      iframe { inset: 48px 0 0 0; height: calc(100% - 48px); }
    }
  </style>
  <script>
    if (/Quest|OculusBrowser|Oculus|Pacific/i.test(navigator.userAgent || "")) {
      location.replace("/games/character-chess/chess-static.html?v=forest1" + (location.search ? "&" + location.search.slice(1) : ""));
    }
  </script>
</head>
<body>
  <div class="bar">
    <a href="/projects">Projects</a>
    <span>Creature Chess<%= typeof alphaUnlocked !== 'undefined' && alphaUnlocked ? ' · Alpha pack' : '' %></span>
    <a href="/">Future Music</a>
  </div>
  <iframe
    title="Creature Chess"
    src="/games/character-chess/chess-static.html?v=forest1<%= typeof sessionId !== 'undefined' && sessionId ? ('&session_id=' + encodeURIComponent(sessionId)) : '' %>"
    allow="fullscreen; gamepad; autoplay; payment; xr-spatial-tracking"
    allowfullscreen
  ></iframe>
</body>
</html>
