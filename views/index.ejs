<!-- BATTLE SPHERE ARENA FEATURED BANNER -->
<section class="relative min-h-[70vh] md:min-h-[75vh] flex items-end md:items-center overflow-hidden border-t border-yellow-900/40">
  <video class="absolute inset-0 w-full h-full object-cover opacity-90" autoplay muted loop playsinline poster="/images/battle-sphere-arena/cover.jpg">
    <source src="/games/battle-sphere-arena/trailer.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-black/25"></div>
  <div class="relative z-10 max-w-6xl mx-auto px-6 py-16 md:py-20 w-full">
    <p class="text-[#20B2AA] tracking-[0.3em] uppercase text-xs font-bold mb-2">New from the Collective</p>
    <h2 class="text-4xl md:text-6xl font-black text-[#F4C430] mb-4 brand-font">BATTLE SPHERE ARENA</h2>
    <p class="text-gray-200 max-w-xl mb-3 text-lg md:text-xl leading-relaxed">
      Zero-g VR melee in a livestreamed coliseum of linked spheres. Fly, cut, lasso, and hunt before your power hits zero.
    </p>
    <p class="text-[#D4AF37] font-bold mb-6 text-sm md:text-base">
      Browser + WebXR · one-time <span class="text-2xl">$15</span>
    </p>
    <a href="/battle-sphere-arena" class="btn-gold px-8 py-4 text-lg rounded-sm inline-block transition-transform hover:-translate-y-1">
      Check out the game →
    </a>
  </div>
</section>

<!-- EXTENDED SECTIONS: PROJECT SHOWCASE -->

<!-- 1. MUSIC: The Final Scene -->
<section class="py-24 border-t border-yellow-900/30 relative">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center px-6">
        
        <!-- Image Content -->
        <div class="order-2 md:order-1 relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-[#D4AF37] to-[#AA8C2C] rounded-lg blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
            <a href="https://www.youtube.com/watch?v=KVBt7cJTn0w" target="_blank" rel="noopener noreferrer" class="relative block aspect-video rounded-lg overflow-hidden border border-[#D4AF37]/30 shadow-2xl">
                <img src="/images/dialup-internet-thumb.jpg" alt="[MASHUP SERMON] - The Sound of Dialup Internet" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700">
                <div class="absolute inset-0 bg-black/40 group-hover:bg-transparent transition-colors duration-500 flex items-center justify-center">
                    <div class="w-16 h-16 rounded-full bg-[#D4AF37]/90 flex items-center justify-center backdrop-blur-sm shadow-lg group-hover:scale-110 transition-transform">
                        <i class="fas fa-play text-black text-xl ml-1"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- Text Content -->
        <div class="order-1 md:order-2 space-y-6">
            <h2 class="text-5xl text-gold brand-font">LATEST TRANSMISSION</h2>
            <h3 class="text-xl text-[#20B2AA] tracking-widest uppercase font-bold">The Sound of Dialup Internet</h3>
            <p class="text-gray-300 leading-loose text-lg">
                [MASHUP SERMON] — a YouTube premiere from Future Music Collective. Watch <em>The Sound of Dialup Internet</em> on our channel — cosmic gearwork, neon new-game energy, and the hymn of the handshake.
            </p>
            <div class="flex flex-col gap-3 pt-2">
                <div class="flex items-center text-gray-400">
                    <i class="fab fa-youtube text-[#D4AF37] w-8"></i>
                    <span>YouTube · Official Channel</span>
                </div>
                <div class="flex items-center text-gray-400">
                    <i class="fas fa-broadcast-tower text-[#D4AF37] w-8"></i>
                    <span>Mashup Sermon Series</span>
                </div>
            </div>
            <a href="https://www.youtube.com/watch?v=KVBt7cJTn0w" target="_blank" rel="noopener noreferrer" class="inline-block mt-6 text-[#D4AF37] border-b border-[#D4AF37] pb-1 hover:text-white transition-colors uppercase tracking-wider text-sm font-bold">
                Watch on YouTube &rarr;
            </a>
        </div>
    </div>
</section>

<!-- 2. SOFTWARE: Color Contagion -->
<section class="py-24 border-t border-yellow-900/30 bg-white/5">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center px-6">
        
        <!-- Text Content -->
        <div class="space-y-6">
            <h2 class="text-5xl text-gold brand-font">TACTICAL SIMULATIONS</h2>
            <h3 class="text-xl text-[#20B2AA] tracking-widest uppercase font-bold">Color Contagion</h3>
            <p class="text-gray-300 leading-loose text-lg">
                Our browser-based engine models the spread of influence through visual data. <strong>Color Contagion</strong> is not just a game; it is a study in dominance, territory, and algorithmic viral mechanics.
            </p>
            <p class="text-gray-400 italic border-l-2 border-[#20B2AA] pl-4">
                "Code is the language of the new reality."
            </p>
            <a href="/projects" class="inline-block mt-6 text-[#D4AF37] border-b border-[#D4AF37] pb-1 hover:text-white transition-colors uppercase tracking-wider text-sm font-bold">
                Run Simulation &rarr;
            </a>
        </div>

        <!-- Image Content -->
        <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-[#20B2AA] to-[#008080] rounded-lg blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
            <a href="/projects" class="relative block aspect-video rounded-lg overflow-hidden border border-[#20B2AA]/30 shadow-2xl bg-gray-900">
                <!-- Using Fallback Image from Projects Page -->
                <img src="/images/FALLBACK_IMG.png" alt="Color Contagion Gameplay" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 opacity-80 group-hover:opacity-100">
                
                <!-- Overlay Interface Elements -->
                <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black to-transparent">
                    <div class="flex justify-between items-end">
                        <span class="text-[#20B2AA] font-mono text-xs">STATUS: ONLINE</span>
                        <i class="fas fa-gamepad text-2xl text-white"></i>
                    </div>
                </div>
            </a>
        </div>

    </div>
</section>

