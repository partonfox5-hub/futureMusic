FROM node:22-bookworm-slim
WORKDIR /app

# Install only runtime dependencies before copying the large static asset tree.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --chown=node:node . .
RUN mkdir -p /app/raw/rampart-uploads \
    && chown node:node /app \
    && chown -R node:node /app/raw

ENV NODE_ENV=production \
    PORT=8080 \
    NODE_OPTIONS=--max-old-space-size=512

# Local map caches and the existing Rampart lab write inside /app.
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||8080)+'/healthz',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1)).setTimeout(4000,function(){this.destroy()})"
CMD ["node", "server.js"]
